# Database / Better Auth (fill these using your own project values)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
NEXT_PUBLIC_BASE_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Storage (server-only secrets; NEVER prefix secret keys with NEXT_PUBLIC_)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Prefer the new Supabase secret key. Legacy service_role is also supported.
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME
# Alternatively: SUPABASE_SERVICE_ROLE_KEY=your_legacy_service_role_key
SUPABASE_PROFILE_BUCKET=profile-photos
SUPABASE_WORKSPACE_BUCKET=profile-photos
SUPABASE_EVIDENCE_BUCKET=claim-evidence

# Optional OpenAI-compatible AI gateway. Configure a vision-capable model for image evidence.
AI_BASE_URL=https://YOUR_PROVIDER_BASE_URL/v1
AI_API_KEY=your_ai_provider_key
AI_MODEL=your_vision_capable_model_id

# Email OTP / invitations / evidence-request email
RESEND_API_KEY=your_resend_api_key
EMAIL_FROM=AutoClaim AI <noreply@your-verified-domain.com>

# OAuth provider variables required by the configured Better Auth providers
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
